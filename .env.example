# ===== AI (Claude) =====
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# review = javoblar avval sizga Telegramda keladi (✅ bossangiz ketadi). auto = darhol yuboriladi
REPLY_MODE=review
POST_MODE=review
TIMEZONE=Asia/Tashkent

# Server internetdagi manzili (Instagram webhook va video yuklash uchun HTTPS shart)
PUBLIC_BASE_URL=https://sizning-domen.uz

# ===== Telegram =====
# @BotFather dan bot yarating. Keyin botga /start yozing — u sizga ID ingizni aytadi.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# ===== Instagram =====
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_APP_SECRET=
IG_VERIFY_TOKEN=kao-verify

# ===== YouTube =====
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_CHANNEL_ID=
YT_UPLOAD_SHORTS=false

# ===== TikTok =====
TIKTOK_BUSINESS_TOKEN=
